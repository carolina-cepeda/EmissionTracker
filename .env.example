# Copia este archivo a .env y pega tus credenciales de Supabase.
# Sin .env (o con VITE_USE_MOCK=true) la app arranca en "modo demo" con datos locales.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Fuerza el modo demo aunque existan credenciales.
VITE_USE_MOCK=false
